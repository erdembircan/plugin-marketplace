      "source": {
        "source": "github",
        "repo": "erdembircan/commit-push-plugin"
      },
      "description": "Git commit and push with conventional commit messages",
      "version": "1.0.0",
      "author": {
        "name": "Erdem Bircan",
        "email": "erdem.erdembircan@gmail.com"
      },
      "homepage": "https://erdembircan.github.io",
