      },
      "description": "Set up a WordPress development environment using Docker with WP-CLI, MariaDB, and Xdebug",
      "version": "1.0.0",
      "author": {
        "name": "Erdem Bircan",
        "email": "erdem.erdembircan@gmail.com"
      },
      "homepage": "https://erdembircan.github.io",
