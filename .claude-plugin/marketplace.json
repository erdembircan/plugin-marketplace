    },
    {
      "name": "testing-philosophy",
      "source": {
        "source": "github",
        "repo": "erdembircan/testing-philosophy-plugin"
      },
      "description": "Enforces behavioral testing philosophy: test what code does for consumers, not how it works internally",
      "version": "1.0.0",
      "author": {
        "name": "Erdem Bircan",
        "email": "erdem.erdembircan@gmail.com"
      },
      "homepage": "https://erdembircan.github.io",
      "repository": "https://github.com/erdembircan/testing-philosophy-plugin",
      "license": "Apache-2.0",
      "keywords": ["testing", "philosophy", "behavioral-testing", "best-practices"],
      "category": "development"
    },
    {
      "name": "usage-band",
      "source": {
        "source": "github",
        "repo": "erdembircan/claude-usage-band"
      },
      "description": "Shows the current session and weekly usage limits in a band above the prompt of the Claude desktop app, and locks a working session against Escape and stray prompts",
      "author": {
        "name": "Erdem Bircan",
        "email": "erdem.erdembircan@gmail.com"
      },
      "homepage": "https://erdembircan.github.io",
      "repository": "https://github.com/erdembircan/claude-usage-band",
      "license": "MIT",
      "keywords": ["usage", "rate-limits", "desktop", "session-lock", "mod"],
      "category": "productivity"
    },
    {
      "name": "pipcast",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/erdembircan/pipcast.git",
        "path": "plugin"
      },
      "displayName": "Pipcast",
      "description": "Picture in picture for Claude Code. While you work in other apps, a small window in the corner of your Mac's screen shows a live board of your sessions, and cuts to BREAKING NEWS, the way a 1990s local TV station would, when one needs you, finishes or stops on an error. A small macOS app that comes with Pipcast runs the window, and nothing leaves your Mac.",
      "author": {
        "name": "Erdem Bircan",
        "url": "https://github.com/erdembircan"
      },
      "homepage": "https://github.com/erdembircan/pipcast",
      "repository": "https://github.com/erdembircan/pipcast",
      "license": "MIT",
      "keywords": ["picture-in-picture", "pip", "notifications", "sessions", "status", "overlay", "macos", "mod"],
      "category": "productivity"
    }
  ]
